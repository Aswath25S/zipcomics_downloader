{
  "manifest_version": 3,
  "name": "Comic Archive Downloader",
  "description": "Save images from the comic reader you have open as a CBR or CBZ archive.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "downloads"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": {"default_title": "Download this comic"},
  "background": {"service_worker": "background.js"}
}
